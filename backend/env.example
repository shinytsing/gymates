# ===============================
# Gymates Backend 环境配置
# ===============================

# 服务器配置
PORT=8080
GIN_MODE=release

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=gymates
DB_PASSWORD=your_password
DB_NAME=gymates_db

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h

# ===============================
# LLM AI 配置
# ===============================

# LLM提供商选择: deepseek, openai, anthropic, zhipu, tongyi
LLM_PROVIDER=deepseek

# DeepSeek配置 (推荐 - 性价比最高)
DEEPSEEK_API_KEY=sk-c4a84c8bbff341cbb3006ecaf84030fe
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# OpenAI配置
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Anthropic Claude配置
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# 智谱AI配置
# LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=your-zhipu-key-here
# ZHIPU_MODEL=glm-4

# 通义千问配置
# LLM_PROVIDER=tongyi
# TONGYI_API_KEY=your-tongyi-key-here

# 通用LLM配置 (覆盖默认值)
# LLM_API_KEY=your-api-key
# LLM_API_URL=https://your-custom-llm-endpoint.com/v1/chat/completions

# ===============================
# TTS 语音合成配置
# ===============================

# TTS提供商: openai, azure, aliyun, google
# 注意: DeepSeek暂不支持TTS，建议使用OpenAI或阿里云TTS
TTS_PROVIDER=openai

# OpenAI TTS配置
TTS_API_KEY=sk-your-openai-api-key-here
# TTS_API_URL=https://api.openai.com/v1/audio/speech
# TTS_VOICE=alloy  # alloy, echo, fable, onyx, nova, shimmer

# Azure TTS配置
# TTS_PROVIDER=azure
# TTS_API_KEY=your-azure-key
# TTS_API_URL=https://YOUR_REGION.tts.speech.microsoft.com/cognitiveservices/v1
# TTS_VOICE=zh-CN-XiaoxiaoNeural

# 阿里云TTS配置 (推荐 - 中文效果好)
# TTS_PROVIDER=aliyun
# TTS_API_KEY=your-aliyun-access-key
# TTS_API_SECRET=your-aliyun-access-secret
# TTS_APP_KEY=your-aliyun-app-key

# ===============================
# CDN 配置
# ===============================

# CDN URL (用于存储音频文件、视频等)
CDN_URL=https://cdn.gymates.com
CDN_ACCESS_KEY=your-cdn-access-key
CDN_SECRET_KEY=your-cdn-secret-key

# ===============================
# Redis 配置 (可选，用于缓存)
# ===============================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===============================
# 第三方服务配置
# ===============================

# 短信服务 (阿里云/腾讯云)
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=your-sms-access-key
SMS_ACCESS_SECRET=your-sms-access-secret

# 邮件服务
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# 对象存储 (OSS/S3)
OSS_PROVIDER=aliyun
OSS_ACCESS_KEY=your-oss-access-key
OSS_ACCESS_SECRET=your-oss-access-secret
OSS_BUCKET=gymates-media
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# ===============================
# 应用配置
# ===============================

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 限流配置
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_DURATION=1m

# ===============================
# 开发配置
# ===============================

# 是否启用调试模式
DEBUG=false

# 是否启用API文档
ENABLE_SWAGGER=true

# 是否启用性能分析
ENABLE_PROFILING=false
