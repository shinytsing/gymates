# Gymates Backend 环境配置

# 应用配置
HOST=0.0.0.0
PORT=8080
GIN_MODE=debug
API_VERSION=v1

# 数据库配置
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gymates
DB_PATH=gymates.db
DB_SSLMODE=disable

# JWT配置
JWT_SECRET=gymates-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# CORS配置
CORS_ORIGINS=*

# 模拟数据开关
MOCK_DATA=true

# AI 服务配置
# DeepSeek AI API (主要AI服务)
DEEPSEEK_API_KEY=sk-c4a84c8bbff341cbb3006ecaf84030fe
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# 高德地图 API
AMAP_API_KEY=a825cd9231f473717912d3203a62c53e
AMAP_API_URL=https://restapi.amap.com/v3

# 可选的其他AI服务
# AIMLAPI_API_KEY=d78968b01cd8440eb7b28d683f3230da
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
